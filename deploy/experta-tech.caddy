(experta_static) {
    root * /srv/experta-tech/current
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    header X-Frame-Options SAMEORIGIN
    file_server
}

experta.tech {
    import experta_static
}

# The production domain is canonical; preserve paths and query strings.
http://79.174.90.25 {
    redir https://experta.tech{uri} 308
}
